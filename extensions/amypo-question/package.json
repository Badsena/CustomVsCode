{
  "name": "amypo-question",
  "displayName": "Amypo Question Panel",
  "description": "Integrated Question Panel for Coding Problems.",
  "version": "1.4.0",
  "publisher": "AMYPO",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "logo.png",
  "activationEvents": [
    "onUri",
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "amypo-sidebar",
          "title": "Amypo",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "amypo-sidebar": [
        {
          "type": "webview",
          "id": "amypoEduView",
          "name": "Amypo EduTech",
          "icon": "logo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "amypo.exit",
        "title": "Exit Amypo Coder"
      },
      {
        "command": "amypo.blockAction",
        "title": "Access Restricted Block"
      }
    ],
    "keybindings": [
      {
        "command": "amypo.blockAction",
        "key": "ctrl+shift+x",
        "when": "true"
      }
    ],
    "uriHandlers": [
      {
        "scheme": "amypocoder"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amypo-coder/amypo-question"
  },
  "license": "MIT",
  "scripts": {
    "compile": "node ../../node_modules/esbuild/bin/esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node",
    "watch": "node ../../node_modules/esbuild/bin/esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@types/extract-zip": "^2.0.0",
    "@types/vscode": "^1.85.0"
  }
}
