{
  "name": "amypo-question",
  "displayName": "Amypo Question Panel",
  "description": "Integrated Question Panel for Coding Problems.",
  "version": "1.0.0",
  "publisher": "AMYPO",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "logo.png",
  "activationEvents": [
    "onUri",
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "amypo-sidebar",
          "title": "Amypo",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "amypo-sidebar": [
        {
          "type": "webview",
          "id": "amypoEduView",
          "name": "Amypo EduTech",
          "icon": "logo.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "../../node_modules/esbuild/bin/esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node",
    "watch": "../../node_modules/esbuild/bin/esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --watch"
  },
  "dependencies": {
    "axios": "^1.14.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
