Windows Registry Editor Version 5.00

; --- Registration for amypo:// ---
[HKEY_CLASSES_ROOT\amypo]
@="URL:Amypo Coder"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\amypo\DefaultIcon]
@="\"C:\\Users\\Admin\\Desktop\\CustomVsCode\\CustomVsCode\\.build\\electron\\AmypoCoder.exe\",0"

[HKEY_CLASSES_ROOT\amypo\shell]
[HKEY_CLASSES_ROOT\amypo\shell\open]
[HKEY_CLASSES_ROOT\amypo\shell\open\command]
@="\"C:\\Users\\Admin\\Desktop\\CustomVsCode\\CustomVsCode\\.build\\electron\\AmypoCoder.exe\" \"C:\\Users\\Admin\\Desktop\\CustomVsCode\\CustomVsCode\" --open-url \"%1\""

